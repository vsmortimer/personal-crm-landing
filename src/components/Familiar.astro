---
import { familiar } from "../content/landing";

const lastIndex = familiar.items.length - 1;
---

<section aria-labelledby="familiar-title" class="border-t border-line">
  <div class="page-container flex flex-col py-16 lg:flex-row lg:flex-wrap lg:gap-16 lg:py-28">
    <div class="flex flex-col lg:grow lg:basis-70">
      <span aria-hidden="true" class="eyebrow">{familiar.number}</span>
      <h2 id="familiar-title" class="mt-3 font-display text-h2 font-medium lg:mt-4 lg:text-h2-lg">{familiar.title}</h2>
    </div>
    <div class="mt-8 flex min-w-0 flex-col lg:mt-0 lg:grow-2 lg:basis-140">
      {
        familiar.items.map((item, index) => (
          <p
            class:list={[
              "border-t border-line py-5 font-display text-quote font-medium lg:py-7 lg:text-quote-lg",
              index === lastIndex && "border-b",
            ]}
          >
            {"text" in item ? (
              item.text
            ) : (
              <>
                {item.before}<em class="text-accent italic">{item.accent}</em>{item.after}
              </>
            )}
          </p>
        ))
      }
    </div>
  </div>
</section>
