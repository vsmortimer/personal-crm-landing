---
import { cardFields } from "../content/landing";

const { fields } = cardFields;

// Mobile: one column, a line under every row but the last.
// Desktop: 2×2 grid, lines between rows and between columns only.
function cellBorders(index: number) {
  const isLast = index === fields.length - 1;
  const inLastRow = index >= fields.length - 2;
  const inLeftColumn = index % 2 === 0;
  return [!isLast && "border-b", inLastRow && "lg:border-b-0", inLeftColumn && "lg:border-r"];
}

// The list is content-box: its 560px flex basis excludes the border, as in the reference.
---

<section aria-labelledby="fields-title" class="bg-ink text-paper">
  <div class="page-container flex flex-col py-16 lg:flex-row lg:flex-wrap lg:gap-16 lg:py-28">
    <div class="flex flex-col lg:grow lg:basis-70">
      <span aria-hidden="true" class="eyebrow text-line-sand">{cardFields.number}</span>
      <h2 id="fields-title" class="mt-3 font-display text-h2 font-medium lg:mt-4 lg:text-h2-lg">{cardFields.title}</h2>
    </div>
    <ul class="mt-8 box-content flex min-w-0 flex-col border border-line-dark lg:mt-0 lg:grid lg:grow-2 lg:basis-140 lg:grid-cols-2">
      {
        fields.map((field, index) => (
          <li class:list={["flex flex-col gap-1 border-line-dark px-5 py-4.5 lg:gap-2 lg:p-8", ...cellBorders(index)]}>
            <span class="text-label text-line-sand uppercase lg:text-label-lg">{field.label}</span>
            {field.text && <span class="text-field lg:text-field-lg">{field.text}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</section>
